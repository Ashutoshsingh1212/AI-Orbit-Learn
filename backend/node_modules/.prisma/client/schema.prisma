generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tool {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  tagLine      String
  description  String
  category     String // e.g., "Text & Writing", "Image Generation", "Coding", "Audio", "Productivity", "Video"
  pricing      String // e.g., "Free", "Freemium", "Paid"
  websiteUrl   String
  rating       Float
  reviewsCount Int      @default(0)
  iconUrl      String
  featured     Boolean  @default(false)
  verified     Boolean  @default(true)
  features     String // JSON-stringified array of feature bullet points
  useCases     String // JSON-stringified array of use cases
  createdAt    DateTime @default(now())

  // Additional fields for compatibility with test suites and relation mapping
  fullDescription String?    @default("")
  url             String?    @default("")
  icon            String?    @default("")
  tags            String?    @default("[]")
  reviews         Review[]
  bookmarks       Bookmark[]
  updatedAt       DateTime   @default(now()) @updatedAt

  @@index([category])
  @@index([pricing])
  @@index([rating])
  @@index([featured])
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  role         String     @default("USER")
  reviews      Review[]
  bookmarks    Bookmark[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  title     String
  content   String
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toolId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(uuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
}
